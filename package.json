{
  "name": "tab-eagle",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/fix-dist.mjs",
    "perf:check": "npm run perf:eagle -- --samples 5 --settled-budget-ms 400 --warm-visible-budget-ms 50 --warm-render-budget 1 --noop-render-budget 0",
    "perf:eagle": "npm run build && node scripts/perf-eagle.mjs",
    "perf:setup": "puppeteer browsers install chrome",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "puppeteer": "^25.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
